# Block .env files
<FilesMatch "\.env$">
    Require all denied
</FilesMatch>

# Block env.php and other config files
<FilesMatch "(env\.php|config\.php)">
    Require all denied
</FilesMatch>

# Block composer files
<FilesMatch "(composer\.json|composer\.lock)">
    Require all denied
</FilesMatch>

# Block SQL dump files
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# Block debug and test files
<FilesMatch "^(debug_|test_)">
    Require all denied
</FilesMatch>

# Block .git folder
RedirectMatch 403 /\.git

# Block access to logs directory
RedirectMatch 403 ^/logs/

# Disable directory listing
Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>